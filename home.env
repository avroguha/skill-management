# Home lab:   docker compose --env-file home.env up --build -d
#
# Public registries, no proxy. The empty lines must stay: an empty value means
# "off", a missing key stops compose. No secrets in this file.

# --- where the build downloads from -------------------------------------------
IMAGE_REGISTRY=
APT_MIRROR=
NPM_REGISTRY=https://registry.npmjs.org/
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# --- how people reach it ------------------------------------------------------------
APP_PORT=8080
APP_BIND=0.0.0.0
# the address people type - the home-lab container (CT 9320); set your own.
APP_URL=http://192.168.5.117:8080
# other addresses the same app is reached at (comma-separated), e.g. a tailnet name
TRUSTED_ORIGINS=
DB_PORT=5433
TZ=Asia/Kolkata

# --- first start ----------------------------------------------------------------------
# true: the demo organisation (Avro Corp, made-up people) is loaded once into an
# empty database; sign in as exec, manager or employee with password "demo".
SEED_DEMO=true
# The seed administrator is admin / admin. true = it must choose a new password
# at the first sign-in.
FORCE_PASSWORD_CHANGE=true
ORG_NAME=Avro Corp

# --- where the data lives -----------------------------------------------------------
# pgdata/ (the database) and secrets/ (generated on the first start)
DATA_DIR=./state
