# Home lab:   docker compose --env-file home.env up --build -d
#
# Public registries, no proxy. The empty lines must stay: an empty value means
# "off", a missing key stops compose. No secrets in this file.

# --- where the build downloads from -------------------------------------------
IMAGE_REGISTRY=
APT_MIRROR=
NPM_REGISTRY=https://registry.npmjs.org/
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# the running app reaches out only for the ServiceNow user sync
RUNTIME_HTTPS_PROXY=

# --- how people reach it ------------------------------------------------------------
# HTTPS on APP_PORT; APP_HTTP_PORT only redirects to it. APP_BIND = the host address
# both are published on (0.0.0.0 = every address).
APP_PORT=443
APP_HTTP_PORT=80
APP_BIND=0.0.0.0
# on = HTTPS with the certificate in TLS_DIR. off = plain HTTP on APP_HTTP_PORT, only
# behind a load balancer or proxy that terminates TLS.
APP_TLS=on
# tls.crt + tls.key. A self-signed one is made on the first start; put the real one
# in with: bash scripts/install-cert.sh <downloaded file> --env-file home.env
TLS_DIR=../skill-management-state/tls
# names the self-signed certificate covers besides localhost and APP_URL's host
TLS_HOSTNAMES=
# the address people type - the home-lab container (CT 9320); set your own.
APP_URL=https://192.168.5.117
# other addresses the same app is reached at (comma-separated), e.g. a tailnet name
TRUSTED_ORIGINS=
DB_PORT=5433
# Worker processes serving requests (empty = one per CPU core, at most 8).
APP_WORKERS=
TZ=Asia/Kolkata

# --- first start ----------------------------------------------------------------------
# The made-up demo organisation is not loaded here: it has its own database, opened with
# the Demo button at the top of the app, and never mixes with the real data.
# The seed administrator is admin / admin. It stays after single sign-on is on (the
# way in when SSO is down); change its password then. true = it must choose a new
# password at the first sign-in.
FORCE_PASSWORD_CHANGE=false
ORG_NAME=Avro Corp

# --- where the data lives -----------------------------------------------------------
# pgdata/ (the database) and secrets/ (generated on the first start). Outside the code
# folder on purpose: replacing the code for a new version can never touch the data.
DATA_DIR=../skill-management-state
# Backups (Admin › Import & export). Ideally another disk or a network share.
BACKUP_DIR=../skill-management-state/backups
