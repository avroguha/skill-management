# Work deployment:   docker compose --env-file work.env up --build -d
#
# The locations below are PLACEHOLDERS on avro.com: replace them on the work
# machine with the site's real image registry prefix, apt mirror, npm registry
# and proxy - and never commit those values. No secrets in this file. Every key
# must stay present; an empty value means "off".

# --- where the build downloads from -------------------------------------------
IMAGE_REGISTRY=registry.avro.com/
APT_MIRROR=http://ubuntu-mirror.avro.com/ubuntu
NPM_REGISTRY=https://npm-mirror.avro.com/
HTTP_PROXY=http://proxy.avro.com:8080
HTTPS_PROXY=http://proxy.avro.com:8080
NO_PROXY=localhost,127.0.0.1,avro.com

# --- how people reach it ------------------------------------------------------------
# Host networking: the app listens on this port on the host itself, behind the
# load balancer that terminates TLS. APP_URL is the https address people type;
# single sign-on needs it exact (it is in the ACS URL given to the identity team).
APP_PORT=8080
APP_BIND=0.0.0.0
APP_URL=https://skills.avro.com
TRUSTED_ORIGINS=
DB_PORT=5433
TZ=UTC

# --- first start ----------------------------------------------------------------------
# false: start with an empty organisation (import it in Admin > Import & export).
# true: load the demo organisation once to evaluate; remove it later in Admin.
SEED_DEMO=false
# The seed administrator is admin / admin, for setup only: once single sign-on works
# and an SSO user is an Administrator, that user disables admin in Admin > Users &
# access. true = it must choose a new password at the first sign-in.
FORCE_PASSWORD_CHANGE=false
ORG_NAME=Avro

# --- where the data lives -----------------------------------------------------------
# Outside the code folder on purpose: copying a newer version of the project over
# this folder must never touch the database. Create it once, as yourself:
#   mkdir -p ../skill-management-state
DATA_DIR=../skill-management-state
