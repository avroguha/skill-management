# Work deployment:   docker compose --env-file work.env up --build -d
#
# The locations below are PLACEHOLDERS on avro.com: replace them on the work
# machine with the site's real image registry prefix, apt mirror, npm registry
# and proxy - and never commit those values. No secrets in this file. Every key
# must stay present; an empty value means "off".

# --- where the build downloads from -------------------------------------------
IMAGE_REGISTRY=registry.avro.com/
APT_MIRROR=http://ubuntu-mirror.avro.com/ubuntu
NPM_REGISTRY=https://npm-mirror.avro.com/
HTTP_PROXY=http://proxy.avro.com:8080
HTTPS_PROXY=http://proxy.avro.com:8080
NO_PROXY=localhost,127.0.0.1,avro.com
# the running app reaches out only for the ServiceNow user sync (to *.service-now.com)
RUNTIME_HTTPS_PROXY=http://proxy.avro.com:8080

# --- how people reach it ------------------------------------------------------------
# HTTPS on APP_PORT; APP_HTTP_PORT only redirects to it. APP_BIND = the host address
# both are published on (0.0.0.0 = every address).
APP_PORT=443
APP_HTTP_PORT=80
APP_BIND=0.0.0.0
# on = HTTPS with the certificate in TLS_DIR. off = plain HTTP on APP_HTTP_PORT, only
# behind a load balancer or proxy that terminates TLS.
APP_TLS=on
# tls.crt + tls.key. A self-signed one is made on the first start; put the company
# certificate in with: bash scripts/install-cert.sh <downloaded file> --host skills.avro.com
TLS_DIR=../skill-management-state/tls
# names the self-signed certificate covers besides localhost and APP_URL's host
TLS_HOSTNAMES=
# The https address people type; single sign-on needs it exact (it is in the ACS URL
# given to the identity team).
APP_URL=https://skills.avro.com
TRUSTED_ORIGINS=
DB_PORT=5433
# Worker processes serving requests (empty = one per CPU core, at most 8).
APP_WORKERS=
TZ=UTC

# --- first start ----------------------------------------------------------------------
# false: start with an empty organisation (import it in Admin > Import & export).
# true: load the demo organisation once to evaluate; remove it later in Admin.
SEED_DEMO=false
# The seed administrator is admin / admin. It stays after single sign-on is on (the
# way in when SSO is down): once SSO works, give your SSO account Administrator and
# change admin's password. true = it must choose a new password at the first sign-in.
FORCE_PASSWORD_CHANGE=false
ORG_NAME=Avro

# --- where the data lives -----------------------------------------------------------
# Outside the code folder on purpose: copying a newer version of the project over
# this folder must never touch the database. Create it once, as yourself:
#   mkdir -p ../skill-management-state
DATA_DIR=../skill-management-state
# Backups (Admin › Import & export: automatic, by hand, and before every restore,
# clear and upgrade). Put this on another disk or a network share, so losing the
# server does not lose the backups with it.
BACKUP_DIR=../skill-management-state/backups
